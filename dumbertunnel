#!/bin/sh
# dumbertunnel serves one site without a Caddyfile: a local port, or a folder of
# files, at one public name. It writes a Caddyfile and runs dumbtunnel on it. It
# is a helper, outside the spec and the spec suite. See README.md.
set -eu

usage() { echo "usage: dumbertunnel NAME [PORT | DIR]" >&2 && exit 2; }
case ${1-} in *.*) ;; *) usage ;; esac
case ${2:-3000} in
*[!0-9]*) [ -d "$2" ] || usage
	# A path with a dot file or folder in it, such as .git or .env, gets a 404.
	site="root * \"$2\"
	@dot path */.*
	respond @dot 404
	file_server" ;;
*) site="reverse_proxy localhost:${2:-3000}" ;;
esac

dir=${DUMBTUNNEL_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dumbtunnel}
mkdir -p "$dir"
# The first block is a copy of the one in Caddyfile.example.
cat >"$dir/dumbertunnel.Caddyfile" <<EOF
# Written by dumbertunnel on every run.
{
	admin off
	https_port {\$DUMBTUNNEL_PORT:8443}
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	cert_issuer acme {\$DUMBTUNNEL_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} {
		disable_http_challenge
	}
}

$1 {
	$site
}
EOF
exec dumbtunnel "$dir/dumbertunnel.Caddyfile"
